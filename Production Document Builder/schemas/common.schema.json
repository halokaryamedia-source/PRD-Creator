{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Production Document Builder \u2014 Common Definitions",
  "$defs": {
    "localizedText": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "localizedTextRequiredBoth": {
      "type": "object",
      "required": [
        "id",
        "en"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "sourceRef": {
      "type": "object",
      "required": [
        "type",
        "ref"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "source",
            "decision",
            "assumption",
            "audit_finding",
            "artifact"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "$ref": "#/$defs/localizedText"
        }
      },
      "additionalProperties": false
    },
    "actionMode": {
      "type": "string",
      "enum": [
        "create",
        "continue",
        "update",
        "audit",
        "render_html"
      ]
    },
    "documentProfile": {
      "type": "string",
      "enum": [
        "complete_game_map",
        "multi_stage_game",
        "single_gameplay",
        "game_system_module",
        "specialized_document"
      ]
    },
    "specialization": {
      "type": "string",
      "enum": [
        "gameplay_design_only",
        "level_design_only",
        "developer_only",
        "scoring_and_data_only",
        "audit_only"
      ]
    },
    "workflowPhase": {
      "type": "string",
      "enum": [
        "project_intake",
        "source_audit",
        "guided_discussion",
        "decision_consolidation",
        "structured_content",
        "content_audit",
        "consistency_audit",
        "user_approval",
        "content_freeze",
        "html_generation",
        "html_audit",
        "delivery"
      ]
    },
    "sectionStatus": {
      "type": "string",
      "enum": [
        "not_started",
        "discussing",
        "drafting",
        "in_review",
        "approved",
        "frozen",
        "needs_revision"
      ]
    },
    "contentStatus": {
      "type": "string",
      "enum": [
        "not_started",
        "drafting",
        "in_review",
        "approved",
        "frozen",
        "needs_revision"
      ]
    },
    "htmlStatus": {
      "type": "string",
      "enum": [
        "not_generated",
        "prototype",
        "generated",
        "audit_required",
        "needs_revision",
        "approved"
      ]
    },
    "finalStatus": {
      "type": "string",
      "enum": [
        "not_approved",
        "approved_for_delivery",
        "delivered"
      ]
    },
    "decisionStatus": {
      "type": "string",
      "enum": [
        "open",
        "recommended",
        "approved",
        "needs_revision",
        "deferred",
        "replaced"
      ]
    },
    "assumptionStatus": {
      "type": "string",
      "enum": [
        "unconfirmed",
        "confirmed",
        "rejected",
        "replaced"
      ]
    },
    "questionStatus": {
      "type": "string",
      "enum": [
        "open",
        "recommended",
        "approved",
        "deferred",
        "closed",
        "replaced"
      ]
    },
    "findingSeverity": {
      "type": "string",
      "enum": [
        "critical",
        "major",
        "minor",
        "suggestion",
        "approved"
      ]
    },
    "findingStatus": {
      "type": "string",
      "enum": [
        "open",
        "recommended",
        "approved_fix",
        "in_progress",
        "resolved",
        "accepted",
        "rejected",
        "replaced"
      ]
    },
    "currentFlow": {
      "type": "object",
      "required": [
        "scope",
        "page",
        "topic"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "completed",
            "blocked"
          ]
        }
      },
      "additionalProperties": false
    },
    "nextStep": {
      "type": "object",
      "required": [
        "action",
        "reason",
        "target_phase"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "target_phase": {
          "$ref": "#/$defs/workflowPhase"
        },
        "target_flow": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "page": {
              "type": "string",
              "minLength": 1
            },
            "topic": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "scope",
            "page"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "criticalValue": {
      "type": "object",
      "required": [
        "value",
        "status",
        "blocking"
      ],
      "properties": {
        "value": {},
        "status": {
          "type": "string",
          "enum": [
            "open",
            "recommended",
            "approved"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "flowStep": {
      "type": "object",
      "required": [
        "number",
        "title",
        "description"
      ],
      "properties": {
        "number": {
          "type": "string",
          "pattern": "^[0-9A-Za-z.-]+$"
        },
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "result": {
          "$ref": "#/$defs/localizedText"
        }
      },
      "additionalProperties": false
    },
    "termRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "versionValue": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    }
  }
}