{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Production Document Builder \u2014 Package Manifest",
  "type": "object",
  "required": [
    "skill",
    "versions",
    "supported_profiles",
    "supported_actions",
    "features"
  ],
  "properties": {
    "skill": {
      "type": "object",
      "required": [
        "name",
        "version",
        "status"
      ],
      "properties": {
        "name": {
          "const": "production-document-builder"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "beta",
            "stable"
          ]
        }
      },
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "required": [
        "template",
        "schema",
        "golden_sample"
      ],
      "properties": {
        "template": {
          "$ref": "common.schema.json#/$defs/versionValue"
        },
        "schema": {
          "$ref": "common.schema.json#/$defs/versionValue"
        },
        "golden_sample": {
          "$ref": "common.schema.json#/$defs/versionValue"
        }
      },
      "additionalProperties": false
    },
    "supported_profiles": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "common.schema.json#/$defs/documentProfile"
      },
      "uniqueItems": true
    },
    "supported_actions": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "common.schema.json#/$defs/actionMode"
      },
      "uniqueItems": true
    },
    "features": {
      "type": "object",
      "required": [
        "bilingual",
        "dark_mode",
        "view_mode",
        "sidebar_collapse",
        "global_tooltip",
        "collapsible_terms",
        "responsive",
        "print_ready"
      ],
      "properties": {
        "bilingual": {
          "type": "boolean"
        },
        "dark_mode": {
          "type": "boolean"
        },
        "view_mode": {
          "type": "boolean"
        },
        "sidebar_collapse": {
          "type": "boolean"
        },
        "global_tooltip": {
          "type": "boolean"
        },
        "collapsible_terms": {
          "type": "boolean"
        },
        "responsive": {
          "type": "boolean"
        },
        "print_ready": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "content_benchmark": {
      "type": "object",
      "required": [
        "package",
        "pages"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "gameplay_overview",
              "level_design",
              "developer"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}