{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "completion-data.schema.json",
  "title": "Production Document Builder \u2014 Completion Data",
  "type": "object",
  "required": [
    "produces_score",
    "valid_completion_condition",
    "recorded_data",
    "interrupted_completion_behavior",
    "duplicate_prevention",
    "handoff_result"
  ],
  "properties": {
    "produces_score": {
      "const": false
    },
    "valid_completion_condition": {
      "$ref": "common.schema.json#/$defs/localizedText"
    },
    "recorded_data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/localizedText"
          },
          "type": {
            "type": "string",
            "enum": [
              "integer",
              "number",
              "boolean",
              "string",
              "duration",
              "timestamp",
              "object",
              "array"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "interrupted_completion_behavior": {
      "$ref": "common.schema.json#/$defs/localizedText"
    },
    "duplicate_prevention": {
      "$ref": "common.schema.json#/$defs/localizedText"
    },
    "handoff_result": {
      "$ref": "common.schema.json#/$defs/localizedText"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sourceRef"
      }
    }
  },
  "additionalProperties": false
}