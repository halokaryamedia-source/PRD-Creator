{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glossary.schema.json",
  "title": "Production Document Builder \u2014 Glossary",
  "type": "object",
  "required": [
    "terms"
  ],
  "properties": {
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "term",
          "definition",
          "scope",
          "aliases",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "term": {
            "$ref": "common.schema.json#/$defs/localizedText"
          },
          "definition": {
            "$ref": "common.schema.json#/$defs/localizedText"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "object",
            "properties": {
              "id": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "en": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": [
              "drafting",
              "approved",
              "needs_revision",
              "deprecated"
            ]
          },
          "index_only": {
            "type": "boolean",
            "default": false
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/sourceRef"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}